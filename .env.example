# 易经 LLM 卜卦 — 环境变量示例
# 复制为 .env 并按需修改（本应用用环境变量，不读 .env 文件也行）

# ── LLM 配置（OpenAI 兼容协议，任意 LLM 都能接）──
# 本地 Ollama 示例：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b
# DeepSeek 示例：  LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# OpenAI 示例：    LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o
# 本地 Gemma 示例：LLM_BASE_URL=http://localhost:8080/v1     LLM_MODEL=gemma-4-26b-a4b-it
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it

# ── 可选 RAG 增强 ──
# 设置指向包含 .md/.txt 文件的目录即可启用知识库检索
# 不设置则纯 LLM 解卦，功能依然完整
ICHING_RAG_DIR=

# ── 服务端口（可选，默认 8088）──
PORT=8088
